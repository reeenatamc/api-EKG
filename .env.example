# Local configuration template. Copy to .env and adjust.
#
#   cp .env.example .env
#
# .env is not versioned. This file is, so that the required variables are documented.

# Signing key for sessions and tokens. Generate one for anything that is not your laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-me

# Never leave this on outside your own machine: DEBUG serves tracebacks to whoever asks.
DEBUG=1

# Comma-separated. In DEBUG this is ignored and every host is accepted, because the phone
# reaches the server by LAN address and that address changes with the network.
ALLOWED_HOSTS=localhost,127.0.0.1

# Where the Open-ECG-Digitizer checkout lives. Unset, ecg_pipeline falls back to a sibling
# directory of its own repo, which is the usual layout here.
# OPEN_ECG_DIGITIZER_HOME=/Users/you/Documents/GitHub/Open-ECG-Digitizer

# Interpretation pathway the worker runs. 'rhythm' is the one to trust for rhythm and rate.
ECG_PATHWAY=rhythm

# Torch device for interpretation. 'cpu' is the validated configuration.
ECG_DEVICE=cpu

# How many observations to return per study, before the app decides where to cut.
ECG_TOP_K=10

# Keep the intermediate files of successful runs under the work directory (rectified
# image, digitizer CSVs and debug images, about 9 MB per study). Failed runs keep theirs
# regardless. Off unless set to 1.
# ECG_KEEP_WORK=1
