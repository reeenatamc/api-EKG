# Local configuration template. Copy to .env and adjust.
#
#   cp .env.example .env
#
# .env is not versioned. This file is, so that the required variables are documented.

# Signing key for sessions and tokens. Generate one for anything that is not your laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-only-insecure-key-change-me

# Never leave this on outside your own machine: DEBUG serves tracebacks to whoever asks.
DEBUG=1

# Comma-separated. In DEBUG this is ignored and every host is accepted, because the phone
# reaches the server by LAN address and that address changes with the network.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included (https://ekg.example.org). Only read outside DEBUG: the
# admin's login form checks CSRF against the Origin/Referer a browser actually used, and
# Caddy is what terminates HTTPS on that domain (see docker-compose.yml).
# CSRF_TRUSTED_ORIGINS=https://ekg.example.org

# --- Database -------------------------------------------------------------------------
# Unset (the default): SQLite, one file, nothing to run alongside runserver. Set to
# 'postgresql' for the piloto's docker-compose.yml, which brings its own `db` service.
# DATABASE_ENGINE=postgresql
# POSTGRES_DB=ekg
# POSTGRES_USER=ekg
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# --- Storage, behind Docker volumes in production --------------------------------------
# Where collectstatic writes the admin's CSS/JS (unfold), and where the DB cache table
# lives if CACHE_BACKEND below is switched to it. All three default to a directory next to
# manage.py, which is exactly right for local development and wrong for a container that
# gets recreated -- docker-compose.yml points each at its own volume.
# STATIC_ROOT=/data/staticfiles
# MEDIA_ROOT=/data/media
# ECG_WORK_ROOT=/data/work

# DRF's per-IP throttling (accounts/throttling.py) keeps its history in this cache.
# LocMemCache (the default) is per-process, which is wrong once gunicorn runs more than
# one worker: each would then enforce the rate against only its own share of traffic.
# DatabaseCache needs no extra service, only `manage.py createcachetable` once (the
# piloto's docker/entrypoint-api.sh does this on every start; harmless once the table
# exists).
# CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# CACHE_LOCATION=django_cache

# HSTS is opt-in: it is a promise that every future deploy on this domain will serve
# HTTPS. Leave unset (0) until the domain is settled; a reasonable value once it is settled
# is 31536000 (a year), the value Django's own deployment checklist suggests raising to.
# SECURE_HSTS_SECONDS=0

# Per-IP limits on the unauthenticated auth endpoints (accounts/throttling.py), each
# DRF's own "<requests>/<period>" syntax. 'auth' covers sign_in and verify_code; 'auth-email'
# covers register and request_password_reset, which each send an email.
# AUTH_THROTTLE_RATE=10/min
# AUTH_EMAIL_THROTTLE_RATE=5/min

# --- Email --------------------------------------------------------------------------
# Unset: the console backend, which is what prints verification codes to the terminal
# running the server in development. Set these for real SMTP delivery; written for Resend
# (resend.com, a free plan covers a piloto's volume), but any TLS/587 SMTP provider works
# the same way -- Brevo is the plan B if Resend's mail is rejected somewhere.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_your_api_key
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=no-reply@your-verified-domain.org

# Upload limits enforced in studies/serializers.py, ahead of anything about the quad.
# Phone photos are 4-15 MB; the pixel limit is what actually catches a decompression bomb,
# since Pillow's own guard only fires around 178 megapixels.
# STUDY_MAX_UPLOAD_SIZE_BYTES=26214400
# STUDY_MAX_UPLOAD_PIXELS=50000000

# Where the Open-ECG-Digitizer checkout lives. Unset, ecg_pipeline falls back to a sibling
# directory of its own repo, which is the usual layout here.
# OPEN_ECG_DIGITIZER_HOME=/Users/you/Documents/GitHub/Open-ECG-Digitizer

# Interpretation pathway the worker runs. 'rhythm' is the one to trust for rhythm and rate.
ECG_PATHWAY=rhythm

# Torch device for interpretation. 'cpu' is the validated configuration.
ECG_DEVICE=cpu

# How many observations to return per study, before the app decides where to cut.
ECG_TOP_K=10

# Directory holding the per-class threshold JSON files ecg-pipeline's Colab notebook
# produces (see that repo's configs/thresholds/README.md). Exported as
# ECGFOUNDER_THRESHOLDS_DIR before ecg_pipeline is imported. Unset, ecg_pipeline falls back
# to its own configs/thresholds/, which is the usual layout here -- this only matters for
# pointing at a different threshold set without touching that checkout.
# ECG_THRESHOLDS_DIR=/Users/you/Documents/GitHub/ecg-pipeline/configs/thresholds

# Keep the intermediate files of successful runs under the work directory (rectified
# image, digitizer CSVs and debug images, about 9 MB per study). Failed runs keep theirs
# regardless. Off unless set to 1.
# ECG_KEEP_WORK=1

# --- Docker Compose (docker-compose.yml, README "Despliegue") ------------------------
# Read only by the compose file and its containers, never by config/settings.py directly.

# The domain Caddy requests a certificate for and the API is reached at. Must exist and
# point at the server before the app's first release build: API_BASE_URL is compiled in.
# DOMAIN=ekg.example.org

# Where the ECGFounder checkpoints live -- a volume, not the image (~700 MB, see README).
# ECGFOUNDER_WEIGHTS_DIR=/data/weights

# How many worker containers run the pipeline at once. Each one holds the interpretation
# model (about 0.7 GB) and, while digitizing, the subprocess that peaks near 4.4 GB more --
# see the deployment report's measurements. Two fits comfortably in 16 GB alongside
# Postgres, Caddy and the API; do not raise this on an 8 GB machine.
# WORKER_REPLICAS=2

# Hard memory ceiling per worker container, Docker kills and restarts one that exceeds it
# rather than letting the host swap or OOM-kill something else. 6g leaves headroom above
# the ~5.1 GB measured peak.
# WORKER_MEMORY_LIMIT=6g

# Threads torch (and the digitizer subprocess, which inherits the environment) uses per
# worker process. Set to this machine's vCPU count divided by WORKER_REPLICAS, so that
# concurrent workers do not oversubscribe the same cores -- e.g. 4 on an 8 vCPU box running
# two workers. Leave unset on a single-worker box to let torch use every core.
# OMP_NUM_THREADS=4

# gunicorn's own knobs. 2 processes and a 120 s timeout are the deployment report's
# recommendation: uploads of 4-15 MB over mobile data can be slow, and the analysis itself
# never runs inside a request (see analysis/management/commands/run_worker.py).
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
